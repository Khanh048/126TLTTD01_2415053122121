<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:id="@+id/tvInfo" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="W01A - Võ Quốc Khánh - 2415053122121"/>

    <EditText android:id="@+id/etName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Tên học phần"
        android:inputType="text"/>
    <EditText android:id="@+id/etQT" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Điểm quá trình QT"
        android:inputType="numberDecimal"/>
    <EditText android:id="@+id/etCK" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Điểm cuối kỳ CK"
        android:inputType="numberDecimal"/>

    <Button android:id="@+id/btnCheck" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Kiểm tra"/>
    <Button android:id="@+id/btnClear" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Xóa"/>

    <TextView android:id="@+id/tvResult" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp"
        android:paddingTop="12dp"/>
</LinearLayout>